NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=example

# Auth (JWT)
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=60

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Files
APP_URL=http://localhost:3000
FILE_TEMP_DIR=./storage/temp
FILE_STORAGE_DIR=./storage/files
SIGNED_URL_SECRET=change-me
